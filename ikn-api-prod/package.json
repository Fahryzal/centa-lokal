{
	"name": "ikn-api",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"prisma": {
		"seed": "ts-node prisma/seed.ts"
	},
	"scripts": {
		"prepare": "husky",
		"build": "prisma generate && nest build",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"format": "prettier --write \"{src,test}/**/*.ts\" && prisma format",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json"
	},
	"dependencies": {
		"@nestjs/axios": "^3.0.3",
		"@nestjs/common": "^10.0.0",
		"@nestjs/config": "^3.2.3",
		"@nestjs/core": "^10.0.0",
		"@nestjs/jwt": "^11.0.0",
		"@nestjs/mapped-types": "^2.0.5",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^10.0.0",
		"@nestjs/swagger": "^7.4.0",
		"@prisma/client": "^5.19.1",
		"@types/multer": "^1.4.12",
		"@types/node-telegram-bot-api": "^0.64.14",
		"@types/passport-jwt": "^4.0.1",
		"archiver": "^7.0.1",
		"aws-sdk": "^2.1692.0",
		"axios": "^1.8.4",
		"bcrypt": "^5.1.1",
		"bcryptjs": "^3.0.2",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"compression": "^1.7.4",
		"cookie-parser": "^1.4.7",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"dayjs": "^1.11.13",
		"decimal.js": "^10.6.0",
		"helmet": "^7.1.0",
		"jwt-decode": "^4.0.0",
		"lodash": "^4.17.21",
		"module-alias": "^2.2.3",
		"morgan": "^1.10.0",
		"node-telegram-bot-api": "^0.67.0",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"passport-local": "^1.0.0",
		"pdf-lib": "^1.17.1",
		"pdf-merger-js": "^5.1.2",
		"reflect-metadata": "^0.2.0",
		"rename-obj-map": "^2.0.2",
		"rxjs": "^7.8.1",
		"uuid": "^11.0.3",
		"winston": "^3.14.2",
		"winston-daily-rotate-file": "^5.0.0"
	},
	"devDependencies": {
		"@irfnd/prettier-config": "^1.0.0",
		"@nestjs/cli": "^10.0.0",
		"@nestjs/schematics": "^10.0.0",
		"@nestjs/testing": "^10.0.0",
		"@swc/cli": "^0.4.0",
		"@swc/core": "^1.7.24",
		"@types/bcrypt": "^5.0.2",
		"@types/compression": "^1.7.5",
		"@types/date-fns": "^2.6.3",
		"@types/express": "^4.17.17",
		"@types/jest": "^29.5.2",
		"@types/lodash": "^4.17.7",
		"@types/module-alias": "^2.0.4",
		"@types/node": "^22.13.11",
		"@types/supertest": "^6.0.0",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"eslint": "^8.42.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"husky": "^9.1.5",
		"jest": "^29.5.0",
		"lint-staged": "^15.2.10",
		"prettier": "^3.0.0",
		"prisma": "^5.19.1",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.1.0",
		"ts-loader": "^9.4.3",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.8.2"
	},
	"prettier": "@irfnd/prettier-config",
	"lint-staged": {
		"**/*.{json,yaml,yml,md}": "prettier --write",
		"**/*.{ts,js,cjs,mjs}": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"moduleNameMapper": {
			"^@src/(.*)$": "<rootDir>/$1",
			"^@modules/(.*)$": "<rootDir>/modules/$1",
			"^@common/(.*)$": "<rootDir>/common/$1",
			"^@shared/(.*)$": "<rootDir>/shared/$1",
			"^@guards/(.*)$": "<rootDir>/guards/$1"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node",
		"watchman": false
	},
	"_moduleAliases": {
		"@src": "dist/src",
		"@modules": "dist/src/modules",
		"@common": "dist/src/common",
		"@shared": "dist/src/shared",
		"@guards": "dist/src/guards"
	},
	"packageManager": "yarn@1.22.22"
}
